{
  "expo": {
    "name": "FlowIQ",
    "slug": "flowiq",
    "scheme": "flowiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#2563EB",
    "platforms": ["web"],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2563EB"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {}
    }
  }
}
